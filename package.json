{
  "name": "umbra",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "Umbra — OSINT suite for handle, mail, host, and phone reconnaissance",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "node scripts/gen-icons.mjs && vite build --config vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:wmn": "tsx scripts/sync-wmn.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "fetch-socks": "^1.3.2",
    "jpeg-js": "^0.4.4",
    "libphonenumber-js": "^1.13.13",
    "p-limit": "^6.2.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "socks": "^2.8.4",
    "tsx": "^4.19.3",
    "undici": "^7.5.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.484.0",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
