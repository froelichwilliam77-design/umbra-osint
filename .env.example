# Optional Umbra environment. Copy to `.env` for local runs.
# Umbra never invents API keys. Unset vars stay off (not a fake miss).

# Persist cases/watches/shares across restarts (npm local)
# UMBRA_CASES_DIR=./data/cases

# Have I Been Pwned v3 — mail dossier breaches
# HIBP_API_KEY=

# Watch alerts (operator inbox only — never the subject, never SMS)
# UMBRA_ALERT_WEBHOOK=
# UMBRA_ALERT_EMAIL=
# RESEND_API_KEY=
# UMBRA_RESEND_API_KEY=
# UMBRA_SMTP_HOST=
# UMBRA_SMTP_PORT=587
# UMBRA_SMTP_USER=
# UMBRA_SMTP_PASS=
# UMBRA_SMTP_FROM=
# UMBRA_TELEGRAM_BOT_TOKEN=
# UMBRA_TELEGRAM_CHAT_ID=

# Optional live phone carrier (skip if unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# NUMVERIFY_API_KEY=
# ABSTRACTAPI_KEY=
# ABSTRACT_PHONE_API_KEY=
# OPENCNAM_SID=
# OPENCNAM_TOKEN=

# Engine
# PORT=43180
# HOST=0.0.0.0
# UMBRA_PROFILE=lean
# UMBRA_POWER=0
# UMBRA_PLAYWRIGHT=0
# UMBRA_PROXY=
# UMBRA_TLS=auto
